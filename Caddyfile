{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000

	# The card index and every collection sit behind login; keep them out of indexes
	# and out of referrer headers regardless.
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
