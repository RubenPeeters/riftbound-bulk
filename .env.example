# Copy to .env and fill in. Never commit real values.
# docker compose reads this file directly.

# How the site is reached. The scheme decides whether Caddy gets a TLS certificate.
#   https://riftbound.example.org   real DNS, automatic Let's Encrypt certificate
#   http://203.0.113.10             just the box's public IP: no DNS, no TLS
APP_URL=http://203.0.113.10

# --- Postgres (owner credentials; migrations and the card loader use these) ---
POSTGRES_DB=riftbound
POSTGRES_USER=riftbound
POSTGRES_PASSWORD=

# --- The application connects as app_user, which is subject to row-level security.
# Create it once and give it a password:
#   make db-shell
#   alter role app_user with password '...';
DATABASE_URL=postgres://app_user:PASSWORD@db:5432/riftbound

# --- Auth.js ---
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Cardmarket, for price snapshots (P4, or P3 if the `tracked` rule uses price) ---
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_TOKEN_SECRET=
